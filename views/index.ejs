<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>PulseBoard — real-time collaborative board</title>
<link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<div class="shell">
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark">◉</div>
      <div>
        <div class="brand-title">PULSEBOARD</div>
        <div class="brand-sub">REAL-TIME COLLABORATIVE WORKSPACE</div>
      </div>
    </div>

    <div class="top-mid">
      <button class="btn ghost" id="new-room" type="button">+ ROOM</button>
      <select id="room-select" class="select" title="Switch board"></select>
    </div>

    <div class="top-right">
      <div class="conn" id="conn"><span class="dot"></span><span id="conn-text">connecting…</span></div>
      <div class="presence" id="presence"></div>
    </div>
  </header>

  <section class="subbar">
    <div class="identity">
      <span class="kicker">YOU ARE</span>
      <input id="my-name" class="name-input" maxlength="24" placeholder="Your name" />
      <span class="you-dot" id="you-dot"></span>
    </div>
    <div class="history">
      <span class="kicker">HISTORY</span>
      <input type="range" id="time-travel" min="0" max="100" value="100" />
      <button class="btn ghost small" id="history-exit" type="button" disabled>LIVE</button>
      <span class="hist-label" id="hist-label"></span>
    </div>
  </section>

  <main class="board" id="board">
    <section class="col" data-status="todo">
      <header class="col-head"><span class="col-dot todo"></span><h3>TO DO</h3><span class="count" data-count="todo">0</span>
        <button class="add" data-add="todo" type="button">+</button>
      </header>
      <div class="cards" data-cards="todo"></div>
    </section>

    <section class="col" data-status="doing">
      <header class="col-head"><span class="col-dot doing"></span><h3>IN PROGRESS</h3><span class="count" data-count="doing">0</span>
        <button class="add" data-add="doing" type="button">+</button>
      </header>
      <div class="cards" data-cards="doing"></div>
    </section>

    <section class="col" data-status="done">
      <header class="col-head"><span class="col-dot done"></span><h3>DONE</h3><span class="count" data-count="done">0</span>
        <button class="add" data-add="done" type="button">+</button>
      </header>
      <div class="cards" data-cards="done"></div>
    </section>

    <div class="cursors" id="cursors"></div>
    <div class="history-banner hidden" id="history-banner">HISTORY VIEW — read only</div>
  </main>

  <footer class="footer">
    <span>PULSEBOARD · OP-LOG SYNC · OFFLINE-CAPABLE</span>
    <span id="ops-count">0 operations</span>
  </footer>
</div>

<script src="/js/board.js"></script>
</body>
</html>
